rules_version = '2';

// Deploy: firebase deploy --only firestore:rules
// Console: Firebase → Firestore → Rules
//
// Requires `userId` on documents (matches request.auth.uid). Legacy docs without
// `userId` will be unreadable until migrated.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsUserField() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownsExistingUserField() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    match /decks/{deckId} {
      allow read: if ownsExistingUserField();
      allow create: if ownsUserField();
      allow update, delete: if ownsExistingUserField();
    }

    match /notes/{noteId} {
      allow read: if ownsExistingUserField();
      allow create: if ownsUserField();
      allow update, delete: if ownsExistingUserField();
    }

    match /flashcards/{flashcardId} {
      allow read: if ownsExistingUserField();
      allow create: if ownsUserField();
      allow update, delete: if ownsExistingUserField();
    }

    // Challenge Mode session summaries (append-only per user)
    match /challenge_sessions/{sessionId} {
      allow read: if ownsExistingUserField();
      allow create: if ownsUserField()
        && request.resource.data.noteId is string
        && request.resource.data.noteId.size() > 0;
      allow update, delete: if false;
    }

    // Per-flashcard study/challenge stats (user-owned).
    // First get() uses getUserFlashcardStat when no doc exists — allow that read so
    // updateFlashcardStats can proceed to setDoc (see exists() short-circuit).
    match /user_flashcard_stats/{statId} {
      allow read: if signedIn()
        && (!exists(/databases/$(database)/documents/user_flashcard_stats/$(statId))
            || resource.data.userId == request.auth.uid);
      allow create: if ownsUserField();
      allow update: if ownsExistingUserField();
      allow delete: if false;
    }
  }
}
